Unattended-Upgrade::Origins-Pattern {
{% for pattern in proxmox_unattended_origins_patterns %}
        "{{ pattern }}";
{% endfor %}
};

Unattended-Upgrade::Package-Blacklist {
{% for package in proxmox_unattended_package_blacklist %}
        "{{ package }}";
{% endfor %}
};

Unattended-Upgrade::Automatic-Reboot "{{ proxmox_unattended_auto_reboot | ternary('true', 'false') }}";
Unattended-Upgrade::Automatic-Reboot-WithUsers "{{ proxmox_unattended_auto_reboot_with_users | ternary('true', 'false') }}";
Unattended-Upgrade::Automatic-Reboot-Time "{{ proxmox_unattended_reboot_time }}";

Unattended-Upgrade::Remove-Unused-Kernel-Packages "false";
Unattended-Upgrade::Remove-New-Unused-Dependencies "true";
Unattended-Upgrade::Remove-Unused-Dependencies "false";

Unattended-Upgrade::SyslogEnable "true";
Unattended-Upgrade::SyslogFacility "daemon";