# Cluster identity
cluster:
  name: homelab
  id: 0

# Kubernetes API
k8sServiceHost: "{{ ansible_host }}"
k8sServicePort: "6443"

# Networking
routingMode: tunnel
tunnelProtocol: vxlan

# Use Kubernetes-managed PodCIDRs
ipam:
  mode: kubernetes

ipv4:
  enabled: true

ipv6:
  enabled: false

# Keep kube-proxy
kubeProxyReplacement: false

# Automatic MTU detection
MTU: 0

# Kubernetes NetworkPolicy support
k8sNetworkPolicy:
  enabled: true

policyEnforcementMode: default

# Automatically restart Cilium pods on configuration changes
rollOutCiliumPods: true

# Allow certificate generation during cluster bootstrap
certgen:
  tolerations:
    - key: node-role.kubernetes.io/control-plane
      operator: Exists
      effect: NoSchedule

# Cilium Agent metrics
prometheus:
  enabled: {{ cilium_service_monitor_enabled | default(false) | bool | lower }}

  serviceMonitor:
    enabled: {{ cilium_service_monitor_enabled | default(false) | bool | lower }}
    trustCRDsExist: {{ cilium_service_monitor_enabled | default(false) | bool | lower }}
    interval: 30s

# Cilium Agent Grafana dashboards
dashboards:
  enabled: {{ cilium_service_monitor_enabled | default(false) | bool | lower }}
  label: grafana_dashboard
  labelValue: "1"
  annotations:
    grafana_folder: Networking

# Cilium Operator
operator:
  replicas: 1
  rollOutPods: true

  prometheus:
    enabled: {{ cilium_service_monitor_enabled | default(false) | bool | lower }}

    serviceMonitor:
      enabled: {{ cilium_service_monitor_enabled | default(false) | bool | lower }}
      interval: 30s

  dashboards:
    enabled: {{ cilium_service_monitor_enabled | default(false) | bool | lower }}
    label: grafana_dashboard
    labelValue: "1"
    annotations:
      grafana_folder: Networking

# Cilium Envoy
envoy:
  rollOutPods: true

  prometheus:
    enabled: {{ cilium_service_monitor_enabled | default(false) | bool | lower }}

    serviceMonitor:
      enabled: {{ cilium_service_monitor_enabled | default(false) | bool | lower }}
      interval: 30s

# Hubble observability
hubble:
  enabled: true

  relay:
    enabled: {{ hubble_relay_enabled | bool | lower }}
    prometheus:
      enabled: {{ cilium_service_monitor_enabled | default(false) | bool | lower }}
      serviceMonitor:
        enabled: {{ cilium_service_monitor_enabled | default(false) | bool | lower }}
        interval: 30s

  ui:
    enabled: {{ hubble_ui_enabled | bool | lower }}

  tls:
    enabled: true

    auto:
      enabled: true
      method: cronJob

  metrics:
{% if cilium_service_monitor_enabled | default(false) | bool %}
    enabled:
      # Namespace/workload labels support the bundled dashboards with bounded cardinality.
      - "dns:sourceContext=namespace;destinationContext=namespace;labelsContext=source_namespace,destination_namespace"
      - drop
      - tcp
      - "flow:sourceContext=namespace;destinationContext=namespace;labelsContext=source_namespace,destination_namespace"
      - port-distribution
      - icmp
      - "httpV2:labelsContext=source_namespace,source_workload,destination_namespace,destination_workload"

{% else %}
    enabled: []
{% endif %}

    serviceMonitor:
      enabled: {{ cilium_service_monitor_enabled | default(false) | bool | lower }}
      interval: 30s

    dashboards:
      enabled: {{ cilium_service_monitor_enabled | default(false) | bool | lower }}
      label: grafana_dashboard
      labelValue: "1"
      annotations:
        grafana_folder: Networking

# Avoid excessive debug logging
debug:
  enabled: false

# Transparent encryption
encryption:
  enabled: false

# BGP Control Plane
bgpControlPlane:
  enabled: false

# Layer 2 announcements
# MetalLB is responsible for LoadBalancer services
l2announcements:
  enabled: false

# Gateway API
gatewayAPI:
  enabled: false

# Cilium Ingress Controller
ingressController:
  enabled: false
