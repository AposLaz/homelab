
# Cluster identity
cluster:
  name: homelab
  id: 0

# Kubernetes API
k8sServiceHost: "{{ ansible_host }}"
k8sServicePort: "6443"

# Networking
routingMode: tunnel
tunnelProtocol: vxlan

# Use Kubernetes-managed PodCIDRs
ipam:
  mode: kubernetes

ipv4:
  enabled: true

ipv6:
  enabled: false

# Keep kube-proxy for the initial installation
kubeProxyReplacement: false

# Keep automatic MTU detection
MTU: 0

# Kubernetes NetworkPolicy support
k8sNetworkPolicy:
  enabled: true

policyEnforcementMode: default

# Allow certificate generation while only the control plane is available.
certgen:
  tolerations:
    - key: node-role.kubernetes.io/control-plane
      operator: Exists
      effect: NoSchedule

# Observability
hubble:
  enabled: true
  relay:
    enabled: {{ hubble_relay_enabled }}
  ui:
    enabled: {{ hubble_ui_enabled }}
  tls:
    enabled: true
    auto:
      enabled: true
      method: cronJob

# Single control-plane homelab
operator:
  replicas: 1

# Avoid excessive debug logging
debug:
  enabled: false

# No advanced features initially
encryption:
  enabled: false

bgpControlPlane:
  enabled: false

l2announcements:
  enabled: false

gatewayAPI:
  enabled: false

ingressController:
  enabled: false
